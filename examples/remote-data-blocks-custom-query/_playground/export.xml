			<content:encoded><![CDATA[<!-- wp:paragraph -->
<p>Insert the block <strong>"WP.org plugin info"</strong>, choose a plugin slug and select a pattern to insert the plugin card with all the info of the plugin retrieved from <em>api.wordpress.org</em></p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p>Example:</p>
<!-- /wp:paragraph -->

<!-- wp:remote-data-blocks/wp-org-plugin-info {"remoteData":{"enabledOverrides":[],"blockName":"remote-data-blocks/wp-org-plugin-info","metadata":{"last_updated":{"name":"Last updated","type":"string","value":"2025-04-29 20:26:43"},"total_count":{"name":"Total count","type":"integer","value":1}},"pagination":[],"queryKey":"display","queryInputs":[{"plugin_slug":"gutenberg"}],"resultId":"387b55bd-03d8-4a1f-a3d6-8e1aad5e076b","results":[{"result":{"name":{"name":"Plugin Name","type":"string","value":"Gutenberg"},"slug":{"name":"Plugin Slug","type":"string","value":"gutenberg"},"version":{"name":"Current Version","type":"string","value":"20.7.0"},"author":{"name":"Plugin Author","type":"string","value":"Matias Ventura"},"rating":{"name":"Average Rating","type":"number","value":42},"num_ratings":{"name":"Number of Ratings","type":"integer","value":3821},"downloaded":{"name":"Download Count","type":"integer","value":45606294},"last_updated":{"name":"Last Updated","type":"string","value":"2025-04-22 11:47am GMT"},"short_description":{"name":"Short Description","type":"string","value":null}},"uuid":"8af94a10-67e2-4e67-bd5f-82f916cca1f7"}]}} -->
<div class="wp-block-remote-data-blocks-wp-org-plugin-info rdb-container"><!-- wp:remote-data-blocks/template -->
<!-- wp:group {"metadata":{"categories":["Remote Data"],"patternName":"remote-data-blocks/pattern-simple","name":"Pattern Simple"},"className":"is-style-section-5","style":{"spacing":{"padding":{"top":"var:preset|spacing|30","bottom":"var:preset|spacing|30","left":"var:preset|spacing|30","right":"var:preset|spacing|30"}}},"layout":{"type":"constrained"}} -->
<div class="wp-block-group is-style-section-5" style="padding-top:var(--wp--preset--spacing--30);padding-right:var(--wp--preset--spacing--30);padding-bottom:var(--wp--preset--spacing--30);padding-left:var(--wp--preset--spacing--30)"><!-- wp:heading {"metadata":{"bindings":{"content":{"source":"remote-data/binding","args":{"block":"remote-data-blocks/wp-org-plugin-info","field":"name"}}},"name":"Plugin Name"},"style":{"elements":{"link":{"color":{"text":"var:preset|color|contrast"}}}},"backgroundColor":"base","textColor":"contrast"} -->
<h2 class="wp-block-heading has-contrast-color has-base-background-color has-text-color has-background has-link-color">Gutenberg</h2>
<!-- /wp:heading -->

<!-- wp:paragraph {"metadata":{"bindings":{"content":{"source":"remote-data/binding","args":{"block":"remote-data-blocks/wp-org-plugin-info","field":"last_updated","label":"Last Updated"}}},"name":"Last Updated"},"className":"rdb-block-data-last-updated","fontSize":"small"} -->
<p class="rdb-block-data-last-updated has-small-font-size">
<span class="rdb-block-label">Last Updated</span> 2025-04-22 11:47am GMT</p>
<!-- /wp:paragraph -->

<!-- wp:group {"style":{"spacing":{"margin":{"top":"var:preset|spacing|30","bottom":"var:preset|spacing|30"}}},"layout":{"type":"flex","flexWrap":"nowrap","justifyContent":"space-between"}} -->
<div class="wp-block-group" style="margin-top:var(--wp--preset--spacing--30);margin-bottom:var(--wp--preset--spacing--30)"><!-- wp:group {"layout":{"type":"flex","flexWrap":"nowrap"}} -->
<div class="wp-block-group"><!-- wp:paragraph -->
<p>author</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"align":"right","metadata":{"bindings":{"content":{"source":"remote-data/binding","args":{"block":"remote-data-blocks/wp-org-plugin-info","field":"author"}}},"name":"Plugin Author"},"className":"rdb-block-data-author is-style-text-annotation","style":{"layout":{"selfStretch":"fit","flexSize":null},"elements":{"link":{"color":{"text":"var:preset|color|contrast"}}}},"backgroundColor":"base","textColor":"contrast"} -->
<p class="has-text-align-right rdb-block-data-author is-style-text-annotation has-contrast-color has-base-background-color has-text-color has-background has-link-color">Matias Ventura</p>
<!-- /wp:paragraph --></div>
<!-- /wp:group -->

<!-- wp:group {"layout":{"type":"flex","flexWrap":"nowrap","justifyContent":"space-between"}} -->
<div class="wp-block-group"><!-- wp:paragraph -->
<p>slug:</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"metadata":{"bindings":{"content":{"source":"remote-data/binding","args":{"block":"remote-data-blocks/wp-org-plugin-info","field":"slug"}}},"name":"Plugin Slug"},"className":"rdb-block-data-slug is-style-text-annotation","style":{"elements":{"link":{"color":{"text":"var:preset|color|contrast"}}}},"backgroundColor":"base","textColor":"contrast"} -->
<p class="rdb-block-data-slug is-style-text-annotation has-contrast-color has-base-background-color has-text-color has-background has-link-color">gutenberg</p>
<!-- /wp:paragraph --></div>
<!-- /wp:group -->

<!-- wp:group {"layout":{"type":"flex","flexWrap":"nowrap","justifyContent":"space-between"}} -->
<div class="wp-block-group"><!-- wp:paragraph -->
<p>version:</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"align":"right","metadata":{"bindings":{"content":{"source":"remote-data/binding","args":{"block":"remote-data-blocks/wp-org-plugin-info","field":"version"}}},"name":"Current Version"},"className":"rdb-block-data-version is-style-text-annotation","style":{"color":{"background":"#ffffff"},"elements":{"link":{"color":{"text":"var:preset|color|contrast"}}}},"textColor":"contrast"} -->
<p class="has-text-align-right rdb-block-data-version is-style-text-annotation has-contrast-color has-text-color has-background has-link-color" style="background-color:#ffffff">20.7.0</p>
<!-- /wp:paragraph --></div>
<!-- /wp:group --></div>
<!-- /wp:group -->

<!-- wp:group {"style":{"spacing":{"margin":{"top":"var:preset|spacing|30","bottom":"var:preset|spacing|30"}}},"layout":{"type":"flex","flexWrap":"nowrap","justifyContent":"space-between"}} -->
<div class="wp-block-group" style="margin-top:var(--wp--preset--spacing--30);margin-bottom:var(--wp--preset--spacing--30)"><!-- wp:group {"layout":{"type":"flex","flexWrap":"nowrap"}} -->
<div class="wp-block-group"><!-- wp:paragraph -->
<p>rating:</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"metadata":{"bindings":{"content":{"source":"remote-data/binding","args":{"block":"remote-data-blocks/wp-org-plugin-info","field":"rating"}}},"name":"Average Rating"},"className":"rdb-block-data-rating is-style-text-annotation"} -->
<p class="rdb-block-data-rating is-style-text-annotation">42</p>
<!-- /wp:paragraph --></div>
<!-- /wp:group -->

<!-- wp:group {"layout":{"type":"flex","flexWrap":"nowrap","justifyContent":"space-between"}} -->
<div class="wp-block-group"><!-- wp:paragraph -->
<p>number of votes:</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"metadata":{"bindings":{"content":{"source":"remote-data/binding","args":{"block":"remote-data-blocks/wp-org-plugin-info","field":"num_ratings"}}},"name":"Number of Ratings"},"className":"rdb-block-data-num-ratings is-style-text-annotation"} -->
<p class="rdb-block-data-num-ratings is-style-text-annotation">3821</p>
<!-- /wp:paragraph --></div>
<!-- /wp:group -->

<!-- wp:group {"layout":{"type":"flex","flexWrap":"nowrap","justifyContent":"space-between"}} -->
<div class="wp-block-group"><!-- wp:paragraph -->
<p>downloads:</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph {"metadata":{"bindings":{"content":{"source":"remote-data/binding","args":{"block":"remote-data-blocks/wp-org-plugin-info","field":"downloaded"}}},"name":"Download Count"},"className":"rdb-block-data-downloaded is-style-text-annotation"} -->
<p class="rdb-block-data-downloaded is-style-text-annotation">45606294</p>
<!-- /wp:paragraph --></div>
<!-- /wp:group --></div>
<!-- /wp:group --></div>
<!-- /wp:group -->
<!-- /wp:remote-data-blocks/template --></div>
<!-- /wp:remote-data-blocks/wp-org-plugin-info -->

<!-- wp:paragraph -->
<p></p>
<!-- /wp:paragraph -->]]></content:encoded>
