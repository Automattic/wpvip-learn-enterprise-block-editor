{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/wp-admin/post.php?post=10&action=edit",
	"login": true,
	"steps": [
		{
			"step": "resetData"
		},
		{
			"step": "defineWpConfigConsts",
			"consts": {
				"USE_PLAYGROUND_CORS_PROXY": true,
				"WP_DEBUG": true,
				"WP_DEBUG_LOG": true,
				"WP_DEBUG_DISPLAY": true
			}
		},
		{
			"step": "installPlugin",
			"options": {
				"activate": true,
				"targetFolderName": "remote-data-blocks"
			},
			"pluginData": {
				"caption": "Installing Remote Data Blocks",
				"resource": "url",
				"url": "https://github-proxy.com/proxy/?repo=Automattic/remote-data-blocks&release=latest&asset=remote-data-blocks.zip"
			}
		},
		{
			"step": "runPHP",
			"code": "<?php\nerror_log('Checking plugin status: ' . print_r(get_option('active_plugins'), true));\nif (function_exists('wp_get_environment_type')) {\n    error_log('Environment type: ' . wp_get_environment_type());\n}\nif (isset($_SERVER['HTTP_HOST'])) {\n    error_log('HTTP_HOST: ' . $_SERVER['HTTP_HOST']);\n}\n?>"
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/Automattic/wpvip-learn-enterprise-block-editor",
				"ref": "HEAD",
				"path": "examples/remote-data-blocks-custom-query"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "importWxr",
			"file": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/Automattic/wpvip-learn-enterprise-block-editor/trunk/examples/remote-data-blocks-custom-query/_playground/export.xml"
			}
		}
	],
	"features": {
		"networking": true
	}
}
