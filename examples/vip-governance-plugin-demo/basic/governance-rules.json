{
	"$schema": "https://api.wpvip.com/schemas/plugins/governance.json",
	"version": "1.0.0",
	"rules": [
		{
			"type": "default",
			"allowedFeatures": ["codeEditor", "lockBlocks"],
			"allowedBlocks": [
				"core/paragraph",
				"core/heading",
				"core/image",
				"core/list",
				"core/quote",
				"core/button",
				"core/columns"
			],
			"blockSettings": {
				"core/heading": {
					"typography": {
						"fontSizes": [
							{
								"name": "Custom_Small",
								"slug": "custom-small",
								"size": "16px"
							},
							{
								"name": "Custom_Medium",
								"slug": "custom-medium",
								"size": "24px"
							},
							{
								"name": "Custom_Large",
								"slug": "custom-large",
								"size": "36px"
							}
						]
					}
				}
			}
		}
	]
}